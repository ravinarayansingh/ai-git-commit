{
  "name": "ai-commit-message-generator",
  "displayName": "AI Git Commit (Ollama & OpenAI)",
  "description": "Generate git commit messages using any OpenAI-compatible LLM (Ollama, vLLM, OpenAI, etc.)",
  "version": "0.1.0",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1b4b",
    "theme": "dark"
  },
  "publisher": "RavinarayanSingh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ravinarayansingh/ai-git-commit.git"
  },
  "bugs": {
    "url": "https://github.com/ravinarayansingh/ai-git-commit/issues"
  },
  "keywords": [
    "git",
    "commit",
    "ai",
    "ollama",
    "openai",
    "llm"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "AI",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitCommitAI.generate",
        "title": "AI: Generate Commit Message",
        "icon": {
          "light": "images/sparkle-light.svg",
          "dark": "images/sparkle-dark.svg"
        }
      },
      {
        "command": "gitCommitAI.setup",
        "title": "AI: Configure API & Model"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "gitCommitAI.generate",
          "when": "scmProvider == git",
          "group": "navigation@1"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "gitCommitAI.generate",
          "when": "scmProvider == git",
          "group": "1_modification"
        }
      ]
    },
    "configuration": {
      "title": "AI Commit Message Generator",
      "properties": {
        "gitCommitAI.apiUrl": {
          "type": "string",
          "default": "http://localhost:11434/v1",
          "description": "Base URL for the OpenAI-compatible API (e.g. Ollama, vLLM, OpenAI). Do not include trailing slash."
        },
        "gitCommitAI.model": {
          "type": "string",
          "default": "gpt-oss:latest",
          "description": "Model name to use for generation (e.g. llama3, gpt-4o, mistral)."
        },
        "gitCommitAI.maxTokens": {
          "type": "number",
          "default": 200,
          "minimum": 10,
          "maximum": 4096,
          "description": "Maximum number of tokens in the generated commit message."
        },
        "gitCommitAI.temperature": {
          "type": "number",
          "default": 0.3,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature. Lower values produce more deterministic output."
        },
        "gitCommitAI.systemPrompt": {
          "type": "string",
          "default": "You are an expert developer. Given the following git diff of staged changes, write a concise, imperative commit message (max 72 chars for the subject line). Output only the commit message text, nothing else.\n\nDiff:\n{diff}",
          "description": "Prompt sent to the LLM. Use {diff} as a placeholder for the staged diff."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "node esbuild.js && node test/runTest.js",
    "vscode:prepublish": "node esbuild.js --minify"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
